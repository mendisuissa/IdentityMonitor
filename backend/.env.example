# ─── Azure AD App Registration ──────────────────────────────────────────────
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
# Optional explicit shared Defender app credentials. If omitted, CLIENT_ID/CLIENT_SECRET are used.
DEFENDER_SHARED_CLIENT_ID=your-client-id
DEFENDER_SHARED_CLIENT_SECRET=your-client-secret

# ─── Webapp (app.modernendpoint.tech) — Intune auto-remediation ─────────────
# Client ID of the webapp's Azure App Registration
WEBAPP_CLIENT_ID=8f42debc-0651-4784-8451-c48446fb2ec9
# Base URL of the IdentityMonitor API (used to build webapp consent callback)
API_BASE_URL=https://api.modernendpoint.tech

# ─── URLs ────────────────────────────────────────────────────────────────────
REDIRECT_URI=https://api.modernendpoint.tech/api/auth/callback
# Must also be registered in Azure Portal → App registration → Authentication → Redirect URIs
ADMIN_CONSENT_REDIRECT_URI=https://api.modernendpoint.tech/api/auth/admin-consent/callback
FRONTEND_URL=https://enrollment.modernendpoint.tech

# ─── Email Alerts ────────────────────────────────────────────────────────────
ALERT_SENDER_EMAIL=alerts@yourdomain.com
ALERT_ADMIN_EMAIL=admin@yourdomain.com

# ─── Azure Table Storage (persistent alerts + baselines) ────────────────────
# Azure Portal → Storage Account → Access keys → Connection string
# Cost: ~$0/month at this scale
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_TENANT_TABLE=TenantIntegrations
AZURE_STORAGE_BLOB_CONTAINER=tenant-snapshots

# ─── Graph Webhooks (real-time sign-in notifications) ───────────────────────
# Must be a PUBLIC HTTPS URL — your Azure App Service URL
WEBHOOK_NOTIFICATION_URL=https://identitymonitor.modernendpoint.tech/api/webhook/notify
WEBHOOK_CLIENT_STATE=change-this-to-a-random-secret

# ─── Telegram Bot (interactive security playbooks) ───────────────────────────
# 1. Message @BotFather → /newbot → copy token
# 2. Message @userinfobot → copy your chat_id
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Set Telegram webhook:
# https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://identitymonitor.modernendpoint.tech/api/webhook/telegram

# ─── Stripe Billing ──────────────────────────────────────────────────────────
# Stripe secret key (starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret (from Stripe Dashboard → Webhooks → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs for each plan (create in Stripe Dashboard → Products)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_MSP=price_...
# Public URL of this app (used for Stripe redirect URLs)
APP_URL=https://identitymonitor.modernendpoint.tech

# ─── Security / Encryption ───────────────────────────────────────────────────
# AES-256-GCM key for encrypting secrets at rest (defenderClientSecret, telegramBotToken, sharedToken).
# Generate with:  openssl rand -hex 32
# REQUIRED in production — app will throw if this is missing when reading/writing secrets.
ENCRYPTION_KEY=your-64-hex-character-key-here

# ─── App Settings ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
SESSION_SECRET=change-this-to-a-long-random-string-32chars+
MOCK_MODE=false
# Set to true to disable trial expiry checks (for self-hosted / MSP operator environments)
BILLING_DISABLED=false
